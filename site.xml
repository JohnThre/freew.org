<site xmlns="https://freew.org/ns/site">
  <name>freew.org</name>
  <url>https://freew.org/</url>
  <description>A presentation of apps and repositories you can use without paying, including free software. The catalog lists Amber Phosphor, CTMU, Gas Plasma, iB-theme, P1PW, RockyBack, and WordPerfect Blue. RockyBack is proprietary.</description>
  <author>
    <name>Pengfan Chang</name>
    <organization url="https://swiphtgroup.com/">Swipht Group</organization>
  </author>
  <main href="https://swiphtgroup.com/">swiphtgroup.com</main>
  <related href="https://clambercloud.com/">clambercloud.com</related>
  <catalog>
    <work id="amberphosphor">
      <name>Amber Phosphor</name>
      <url>https://freew.org/amberphosphor/</url>
      <source>https://github.com/JohnThre/AmberPhosphor-theme</source>
      <charge>free</charge>
      <freedom license="GPL-3.0">free-software</freedom>
      <summary>Amber phosphor terminal theme for Apple Terminal and iTerm2.</summary>
    </work>
    <work id="ctmu">
      <name>CTMU</name>
      <url>https://freew.org/ctmu/</url>
      <source>https://github.com/JohnThre/CTMU-for-macOS</source>
      <charge>free</charge>
      <freedom license="GPL-3.0">free-software</freedom>
      <summary>A command-line tool for macOS.</summary>
    </work>
    <work id="gasplasma">
      <name>Gas Plasma</name>
      <url>https://freew.org/gasplasma/</url>
      <source>https://github.com/JohnThre/GasPlasma-theme</source>
      <charge>free</charge>
      <freedom license="GPL-3.0-or-later">free-software</freedom>
      <summary>Orange-dominant dark theme for Apple Terminal, iTerm2, VS Code, and Zed.</summary>
    </work>
    <work id="ibtheme">
      <name>iB-theme</name>
      <url>https://freew.org/ibtheme/</url>
      <source>https://github.com/JohnThre/iB-theme</source>
      <charge>free</charge>
      <freedom license="GPL-3.0-or-later">free-software</freedom>
      <summary>IBM Carbon theme for Cursor, VS Code, GNU Emacs, Vim, Neovim, CotEditor, Apple Terminal, and iTerm2.</summary>
    </work>
    <work id="p1pw">
      <name>P1PW</name>
      <url>https://freew.org/p1pw/</url>
      <source>https://github.com/JohnThre/P1PW-theme</source>
      <charge>free</charge>
      <freedom license="GPL-3.0">free-software</freedom>
      <summary>Warm, paper-toned light theme for Apple Terminal.</summary>
    </work>
    <work id="rockyback">
      <name>RockyBack</name>
      <url>https://freew.org/rockyback/</url>
      <source>https://github.com/JohnThre/rockyback</source>
      <charge>free</charge>
      <freedom license="proprietary">not-free-software</freedom>
      <summary>Prepares Rocky Linux 9 or AlmaLinux 9 and installs ClambBack.</summary>
    </work>
    <work id="wordperfectblue">
      <name>WordPerfect Blue</name>
      <url>https://freew.org/wordperfectblue/</url>
      <source>https://github.com/JohnThre/WordPerfectBlue-theme</source>
      <charge>free</charge>
      <freedom license="GPL-3.0">free-software</freedom>
      <summary>WordPerfect 5.1 white-on-blue theme for Apple Terminal.</summary>
    </work>
